{
  "name": "oguzdows-mobile-design-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/core.test.mjs tests/everyday-core.test.mjs tests/rifki.test.mjs",
    "test:browser": "node --test tests/browser.test.mjs tests/everyday-browser.test.mjs",
    "test:native": "python3 -m unittest discover -s ../tests -p \"test_*.py\" -v",
    "format:check": "prettier --check \"src/**/*.{tsx,mjs,css}\" \"server/**/*.mjs\" \"tests/**/*.mjs\" vite.config.ts package.json tsconfig.json"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "lucide-react": "0.468.0",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@sparticuz/chromium": "133.0.0",
    "@types/node": "22.10.5",
    "@types/react": "19.0.3",
    "@types/react-dom": "19.0.2",
    "@vitejs/plugin-react": "4.7.0",
    "playwright-core": "1.65.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "6.4.6"
  }
}
