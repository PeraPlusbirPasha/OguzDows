# Optional, OFF by default. These are read by the SERVER, never VITE_* variables.
# Do not enable a paid model on a public preview without authentication/quota controls.
RIFKI_ENABLED=false
# OpenAI-compatible base URL, without /chat/completions. HTTPS, or HTTP loopback only.
# This loopback address is used only by the server, NEVER by the user's browser.
RIFKI_API_BASE=http://127.0.0.1:8080/v1
RIFKI_MODEL=local-model
RIFKI_MODEL_LABEL=Seçtiğim üretken model
RIFKI_API_KEY=
